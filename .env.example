# Copy to .env for local dev (or set these in your host's dashboard). All optional.
PORT=3000
# Used only the first time you sign in, to create the admin account.
ADMIN_PASSWORD=ChangeMe123!
# If empty, a random secret is generated and saved automatically
# (data/secret.json locally, or in Postgres on Vercel).
JWT_SECRET=

# --- Vercel only — set automatically when you connect these in the ---
# --- Storage tab of your Vercel project. No need to set them here.  ---
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=

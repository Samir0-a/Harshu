# --- Environment Variables ---
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://username:password@cluster.mongodb.net/finance_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/finance_portfolio

# Initial Admin Password (used if no admin user exists in DB yet)
ADMIN_PASSWORD=ChangeMe123!

# JWT Secret for authenticating admin sessions
JWT_SECRET=super_secret_jwt_key_finance_portfolio_2026
